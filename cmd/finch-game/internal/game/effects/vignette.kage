//kage:unit pixels

package main

// Strength is how dark the corners get. 0 turns it off.
var Strength float

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := imageSrc0At(src)
	uv := (src - imageSrc0Origin()) / imageSrc0Size()
	d := distance(uv, vec2(0.5))
	v := 1 - smoothstep(0.3, 0.75, d)*Strength
	return vec4(c.rgb*v, c.a)
}
